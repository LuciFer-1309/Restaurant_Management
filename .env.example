# Server Configuration
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Option 1: Supabase / Cloud PostgreSQL (Recommended for Supabase)
# Paste the URI string from Supabase (Project Settings -> Database -> Connection string)
# Note: SSL is automatically enabled when using a supabase.co or pooler.supabase.com URI.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Option 2: Individual Connection Variables (Local PostgreSQL or Custom Setup)
# Used automatically if DATABASE_URL is commented out or left empty
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_management_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_SSL=false
DB_MAX_CONNECTIONS=10
